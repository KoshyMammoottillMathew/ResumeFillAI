{
  "manifest_version": 3,
  "name": "ResumeFill AI",
  "version": "0.1.0",
  "description": "Privacy-first job application autofill companion for ResumeFill AI.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "ResumeFill AI"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
